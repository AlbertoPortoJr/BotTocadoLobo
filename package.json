{
  "name": "discord-ts-bot",
  "version": "0.1.0",
  "description": "Discord bot in TypeScript with PostgreSQL and Docker",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "register": "ts-node-dev --respawn --transpile-only src/deploy-commands.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.13.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.6.0"
  }
}
