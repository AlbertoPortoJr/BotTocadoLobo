{
  "name": "discord-ts-bot",
  "version": "0.1.0",
  "description": "Discord bot in TypeScript with PostgreSQL and Docker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy:commands": "ts-node src/deploy-commands.ts",
    "test": "npm run build && node --test tests/inventory.test.cjs",
    "lint": "eslint 'src/**/*.{ts,js}' --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.13.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.6.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
